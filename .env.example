# VASCO API konfiguracija
API_USER=
API_PASS=
API_TAX_NUMBER=
EVASCO_BASE_URL=http://<evasco-host>:<port>

# Skupni skrivni kljuc za GUI <-> backend avtentikacijo (glej README.md,
# "Avtentikacija GUI <-> backend"). GUI ga posreduje v headerju `X-API-Key`;
# brez ujemajoce vrednosti backend zavrne vse klice na /api/obdelaj.
# Isto vrednost vpisi v gui/.env kot API_KEY.
# Zgeneriraj novo z: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# TESTNO OBDOBJE (glej README.md / app/config.py): spodnja meja (vkljucno)
# stevilke delovnega naloga, ki se obdeluje - DN z nizjo stevilko se
# izlocijo. 1 = brez omejitve.
DN_STEVILKA_OD=1

# TESTNO OBDOBJE (glej README.md / app/config.py): oba PUT-a na prevzemnico
# (glava + spremembaPostavk) sta objavljena v swaggerju in implementirana,
# a se dejanski PUT klic med rocnim testiranjem preskoci, dokler je to True
# - sistem takrat vse podatke pridobi in izracuna, telesi PUT-a pa samo
# arhivira v data/izhodni_zahtevki/. Nastavi na False, ko je izpis rocno
# preverjen in potrjen.
PUT_PREVZEMNICA_DRY_RUN=True
