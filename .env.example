# VASCO API konfiguracija
API_USER=
API_PASS=
API_TAX_NUMBER=
EVASCO_BASE_URL=http://<evasco-host>:<port>

# Skupni skrivni kljuc za GUI <-> backend avtentikacijo (glej README.md,
# "Avtentikacija GUI <-> backend"). GUI ga posreduje v headerju `X-API-Key`;
# brez ujemajoce vrednosti backend zavrne vse klice na /api/step1 in /api/step2.
# Isto vrednost vpisi v gui/.env kot API_KEY.
# Zgeneriraj novo z: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
